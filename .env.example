# ── 서버 ──────────────────────────────────────────────────────────────────
# API 서버 포트 (npm run dev 에서는 3001, npm start 에서는 3000)
PORT="3000"

# 관리자 비밀번호 (평문). 최초 실행 시 scrypt 해시로 변환되어 data/admin.json 에 저장됩니다.
# ⚠️ 설정하지 않으면 기본값 1012 가 사용되며, 서버 기동 시 경고가 출력됩니다.
#    변경 후에는 `npm run set-password -- 새비밀번호` 를 쓰는 것을 권장합니다.
ADMIN_PASSWORD=""

# 세션 서명 키 (32자 이상). 비워 두면 data/session.key 에 자동 생성됩니다.
# 여러 인스턴스로 운영할 때는 반드시 동일한 값을 공통 설정하세요.
SESSION_SECRET=""

# 데이터 저장 위치 (기본: ./data)
# DATA_DIR="./data"

# 요청 본문 최대 크기 (이미지 base64 포함). 기본 25mb
# JSON_LIMIT="25mb"

# 추가로 허용할 출처 (콤마 구분). 보통은 비워 두면 됩니다.
# ALLOWED_ORIGINS="https://your-domain.com"

# ── AI Studio 템플릿에서 유래한 값 (현재 코드에서 사용하지 않음) ──────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
